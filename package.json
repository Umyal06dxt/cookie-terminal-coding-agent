{
  "name": "cookie",
  "version": "0.1.0",
  "description": "A terminal coding agent on the Command Code Provider API",
  "type": "module",
  "private": true,
  "bin": {
    "cookie": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
