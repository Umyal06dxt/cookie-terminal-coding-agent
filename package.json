    "build": "bun run scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "ink": "^8.0.0",
    "openai": "^7.34.0",
    "react": "^19.3.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  }
}
